# Local runner config for the Google Chrome connector.
# The Chrome profile directory is detected from the host OS, so it is not
# configurable. Copy this file to .env to run the local runner.

# REQUIRED. How far back to index history: 7d | 30d | 90d | 365d | all
GETY_CONFIG_HISTORY_RANGE=90d

# Optional toggles (true/false). Manifest defaults are used when unset.
# GETY_CONFIG_INDEX_BOOKMARKS=true
# GETY_CONFIG_INDEX_HISTORY=true

# Index all numbered Chrome profiles, or only Default.
# GETY_CONFIG_PROFILE_SCOPE=all

# Skip non-http(s) history URLs (chrome://, file://, about:).
# GETY_CONFIG_HISTORY_SKIP_NON_WEB=true
